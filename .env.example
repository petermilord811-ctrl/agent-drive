# agent-drive/.env — defaults read by core/agent-join.js at startup.
# Copy this file to `.env` and fill it in. `.env` is gitignored (it holds a secret); this example is
# committed and holds no values. An environment variable already set OVERRIDES the matching line here,
# so `SM_JOIN_KEY=… node core/agent-join.js …` still wins. `--env <file>` or SM_ENV_FILE picks another file.

# The right to ASK to join a machine. The relay must hold the same secret. REQUIRED.
SM_JOIN_KEY=

# The default relay to dial. The live relay DRIFTS, so override per run with --relay when you know the
# current one. Use the cert-valid sslip/duckdns NAME, never a bare IP (TLS rejects the IP).
SM_RELAY=wss://relay.example.com

# Comma-separated fallback relays the auto-reconnect tries if the host is no longer on SM_RELAY.
SM_RELAYS=

# Standing yes at the confirm gate (serve mode). Empty / unset = OFF: before anything hard to undo
# (restart, shut down, delete or move files, sign out, stop a service…) the agent announces it in the
# host's session chat and waits for a human "yes"; a silent window stays unclear and a real restart
# treats that as no. Set to 1 (or true/yes/on) and the operator has PRE-APPROVED these: the agent still
# announces and still waits the window, and a "stop/no/wait" still cancels at any point — only a SILENT
# window now counts as yes, so the agent works on instead of stalling when no one is there to type it.
# It never bypasses the door: a person still pressed Allow to grant control/shell. (--auto-confirm turns
# it on for one run.) Leave it OFF when someone is at the machine to answer.
SM_AUTO_CONFIRM=

# Humanize API key — read from the environment by whatever uses it.
HUMANIZE_API_KEY=
